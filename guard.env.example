# Copy to guard.env and edit. All values are optional except CANONICAL_RPC
# (needed for chain-drift detection) and SSH_ALLOWLIST (for the SSH tripwire).

STACK_DIR=/opt/blockdag-stack               # dir holding node.conf + ops/runtime/
EVM_RPC=http://127.0.0.1:18545              # local node EVM JSON-RPC
CANONICAL_RPC=                              # trusted external reference RPC for drift checks
NODE_CONTAINER=node
POOL_MATCH=^pool                            # regex matching the running pool container name
MIN_PEERS=2
STALL_MIN=8
MAX_LAG=5000
SSH_ALLOWLIST=                              # CSV of expected SSH source IPs, e.g. 10.0.0.5,10.0.0.6
AUTH_LOG=/var/log/auth.log
LEASE_REFRESH_CMD=                          # optional: command to mint/refresh a pool start-lease
AUTO_HEAL=0                                 # 1 = clear STALE holds + restart pool (node never touched)
